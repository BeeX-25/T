{
  "server": {
    "host": "0.0.0.0",
    "port": 8099,
    "auth_token": ""
  },
  "state_file": "~/.smarttv/state.json",

  "tv": {
    "order": ["enigma2", "cec", "ir", "samsung", "webos"],

    "enigma2": {
      "enabled": false,
      "host": "192.168.1.30",
      "port": 80,
      "username": "root",
      "password": "",
      "stream_port": 8001,
      "service_type": 4097,
      "deep_standby": false
    },

    "cec": {
      "enabled": true,
      "binary": "cec-client",
      "adapter": "",
      "osd_name": "SmartBridge",
      "tv_address": 0,
      "source_address": 4,
      "timeout": 12
    },

    "ir": {
      "enabled": false,
      "brand": "samsung",
      "address": null,
      "repeat": 1,
      "command": "",
      "brands": {
        "my_tv": {
          "protocol": "nec",
          "address": 4,
          "keys": { "power": 8, "volume_up": 2, "volume_down": 3 }
        }
      }
    },

    "samsung": {
      "enabled": false,
      "host": "192.168.1.50",
      "port": 8002,
      "mac": "",
      "token_file": "~/.smarttv/samsung_token.txt"
    },

    "webos": {
      "enabled": false,
      "host": "192.168.1.51",
      "mac": "",
      "key_file": "~/.smarttv/webos_key.json"
    }
  },

  "player": {
    "enabled": true,
    "backend": "auto",
    "mpv": {
      "binary": "mpv",
      "ipc_socket": "/tmp/smarttv-mpv.sock",
      "args": [
        "--fullscreen",
        "--force-window=yes",
        "--ytdl-format=bestvideo[height<=?1080]+bestaudio/best"
      ]
    },
    "android": {
      "app": "vlc",
      "use_input_keyevents": false
    },
    "enigma2": {
      "host": "",
      "port": 80,
      "username": "",
      "password": "",
      "stream_port": 8001,
      "service_type": 4097
    }
  },

  "catalog": {
    "cache_hours": 6,
    "cache_dir": "~/.smarttv/cache",
    "timeout": 20,
    "sources": [
      {
        "name": "قنوات عربية مفتوحة (iptv-org)",
        "type": "m3u",
        "kind": "live",
        "url": "https://iptv-org.github.io/iptv/languages/ara.m3u"
      },
      {
        "name": "دليل البرامج",
        "type": "xmltv",
        "url": "https://iptv-org.github.io/epg/guides/ar.xml"
      },
      {
        "name": "قنوات الرسيفر",
        "type": "enigma2",
        "host": "192.168.1.30",
        "port": 80,
        "stream_port": 8001
      },
      {
        "name": "اشتراكي (Xtream)",
        "type": "xtream",
        "url": "http://provider.example:8080",
        "username": "",
        "password": "",
        "kinds": ["live", "movies", "series"],
        "live_extension": "ts"
      },
      {
        "name": "أفلامي المحلية",
        "type": "m3u",
        "kind": "movies",
        "path": "~/media/movies.m3u"
      },
      {
        "name": "مسلسلاتي",
        "type": "m3u",
        "kind": "series",
        "path": "~/media/series.m3u"
      }
    ]
  },

  "shortcuts": [
    { "name": "YouTube", "url": "https://www.youtube.com" }
  ],

  "automation": {
    "sleep_timer_minutes": 45,
    "rules": [
      { "name": "إطفاء تلقائي بعد منتصف الليل", "cron": "0 2 * * *", "action": "power_off" }
    ]
  }
}
